{
  "name": "sport-manager-api",
  "version": "1.0.0",
  "description": "api para manejo de turnos de padel, con dueños que pueden publicar sus canchas y usuarios que pueden sacar turnos para reservarlas",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "dev:api": "nodemon src/index.ts --api",
    "build": "npx prisma generate && tsc",
    "start": "node dist/index.js",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d",
    "test:db:push": "dotenv -e .env.test -- npx prisma db push --accept-data-loss",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "pretest": "npm run test:db:up && node -e \"setTimeout(()=>{}, 3000)\" && npm run test:db:push",
    "test": "dotenv -e .env.test -- jest --detectOpenHandles",
    "posttest": "npm run test:db:down"
  },
  "author": "Rodrigo Chavez | @rodrichc",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/node": "^20.11.30",
    "bcrypt": "^6.0.0",
    "cloudinary": "^1.41.3",
    "colors": "^1.4.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.1",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^3.6.1",
    "multer": "^2.2.0",
    "multer-storage-cloudinary": "^4.0.0",
    "otplib": "^13.4.1",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "resend": "^6.17.1",
    "slugify": "^1.6.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/slug": "^5.0.9",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.11",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.11"
  }
}
